  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceType String   // Service History, Oil Change, Tire Replacement, Repairs
  description     String   @db.VarChar(1000)
  maintenanceCost Float    @default(0.0)
  maintenanceDate DateTime @default(now())
  completedAt     DateTime?
  status          String   @default("Scheduled") // Scheduled, In Progress, Completed, Cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([vehicleId])
}

model VehicleFuelLog {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fuelQuantity Float    // in Liters
  cost        Float    // total cost
  odometerReading Float
  fillDate    DateTime @default(now())
  remarks     String?  @db.VarChar(500)

  @@index([vehicleId])
}

model VehicleTrip {
  id         Int            @id @default(autoincrement())
  vehicleId  Int
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId   Int
  driver     Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  routeId    Int
  route      TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  tripDate   DateTime       @default(now())
  status     String         @default("Completed") // Scheduled, Ongoing, Completed, Cancelled
  startOdometer Float?
  endOdometer   Float?
  notes      String?        @db.VarChar(500)

  @@index([vehicleId])
  @@index([driverId])
  @@index([routeId])
}

model TransportAttendance {
  id             Int                   @id @default(autoincrement())
  registrationId Int
