  @@index([jobPostingId])
}

model HostelBuilding {
  id           Int                @id @default(autoincrement())
  buildingCode String             @unique
  buildingName String
  gender       String             // Male, Female, Mixed
  address      String?
  totalFloors  Int                @default(1)
  totalRooms   Int                @default(0)
  totalBeds    Int                @default(0)
