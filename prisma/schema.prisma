model AssetAssignment {
  id           Int      @id @default(autoincrement())
  assetId      Int
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedTo   String
  assignedType String   // Staff, Department, Student
  assignedDate DateTime @default(now())
  returnedDate DateTime?
  condition    String?
  remarks      String?  @db.VarChar(500)

  @@index([assetId])
}

model AssetMaintenance {
  id              Int       @id @default(autoincrement())
  assetId         Int
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  maintenanceDate DateTime  @default(now())
  completedDate   DateTime?
  cost            Float     @default(0.0)
  performedBy     String
  description     String    @db.VarChar(1000)
  status          String    @default("Pending") // Pending, Completed, Cancelled

  @@index([assetId])
}

model FacilityBooking {
  id             Int      @id @default(autoincrement())
  roomId         Int
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookedBy       String   // user email or name
  bookingPurpose String
  bookingDate    DateTime
  startTime      String   // e.g. "09:00"
  endTime        String   // e.g. "10:30"
  attendees      Int      @default(0)
  approvalStatus String   @default("Pending") // Pending, Approved, Rejected, Cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([roomId])
}

model MaintenanceRequest {
  id               Int       @id @default(autoincrement())
  buildingId       Int
  building         Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  roomId           Int?
  room             Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  requestedBy      String    // user email
  issueCategory    String    // Plumbing, Electrical, HVAC, Furniture, IT, General
  issueDescription String    @db.VarChar(1000)
  priority         String    @default("Medium") // Low, Medium, High, Critical
  assignedTo       String?   // technician email or name
  status           String    @default("Open") // Open, Assigned, In Progress, Completed, Closed
  completionDate   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([buildingId])
  @@index([roomId])
}

model ResearchProject {
  id                     Int             @id @default(autoincrement())
  uuid                   String          @unique @default(uuid())
  projectCode            String          @unique
  title                  String
  abstract               String          @db.VarChar(2000)
  principalInvestigatorId Int
  principalInvestigator  Teacher         @relation(fields: [principalInvestigatorId], references: [id])
  departmentId           Int
  department             Department      @relation(fields: [departmentId], references: [id])
  researchArea           String
  startDate              DateTime
  endDate                DateTime
  totalBudget            Float           @default(0.0)
  utilizedBudget         Float           @default(0.0)
  fundingSourceId        Int?
  fundingSource          Grant?          @relation(fields: [fundingSourceId], references: [id])
  status                 String          @default("Draft") // Draft, Submitted, Approved, Active, On Hold, Completed, Cancelled
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  
  publications           Publication[]
  ethicsApprovals        ResearchEthics[]

  @@index([principalInvestigatorId])
  @@index([departmentId])
  @@index([fundingSourceId])
}

model Grant {
  id                  Int               @id @default(autoincrement())
  uuid                String            @unique @default(uuid())
  grantCode           String            @unique
  fundingAgency       String
  grantTitle          String
  amount              Float
  currency            String            @default("USD")
  applicationDeadline DateTime
  awardDate           DateTime?
  startDate           DateTime?
  endDate             DateTime?
  status              String            @default("Open") // Open, Applied, Awarded, Rejected, Closed
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  
  projects            ResearchProject[]
}

model Publication {
  id              Int             @id @default(autoincrement())
  uuid            String          @unique @default(uuid())
  title           String
  publicationType String          // Journal, Conference, Book, Chapter, Patent, Thesis
  publisher       String?
  publicationDate DateTime
  doi             String?
  isbn            String?
  indexedIn       String?         // ORCID, Scopus, Web of Science, Google Scholar
  projectId       Int?
  project         ResearchProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([projectId])
}

model ResearchEthics {
  id                Int             @id @default(autoincrement())
  uuid              String          @unique @default(uuid())
  projectId         Int
  project           ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicationDate   DateTime        @default(now())
  committeeDecision String          @default("Pending") // Pending, Approved, Rejected, Revision Required
  approvalNumber    String?
  expiryDate        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([projectId])
}

model AccreditationAgency {
  id                Int                     @id @default(autoincrement())
  uuid              String                  @unique @default(uuid())
  agencyCode        String                  @unique
  agencyName        String
  country           String
  website           String?
  accreditationType String                  // National, International, Professional
  status            String                  @default("Active") // Active, Inactive
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  programs          AccreditationProgram[]
}

model AccreditationProgram {
  id                 Int                  @id @default(autoincrement())
  uuid               String               @unique @default(uuid())
  agencyId           Int
  agency             AccreditationAgency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  departmentId       Int
  department         Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  programId          Int
  program            Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  accreditationCycle String               // e.g., "2025-2030"
  startDate          DateTime
  expiryDate         DateTime
  status             String               @default("Planning") // Planning, Self Study, Under Review, Approved, Expired
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([agencyId])
  @@index([departmentId])
  @@index([programId])
}

model LearningOutcome {
  id           Int         @id @default(autoincrement())
  uuid         String      @unique @default(uuid())
  outcomeType  String      // CLO, PLO, PEO
  code         String      // e.g., CLO-1, PLO-2
  title        String
  description  String      @db.VarChar(1000)
  departmentId Int
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  programId    Int?
  program      Program?    @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([departmentId])
  @@index([programId])
}

model QualityIndicator {
  id                   Int      @id @default(autoincrement())
  uuid                 String   @unique @default(uuid())
  indicatorName        String
  targetValue          Float
  achievedValue        Float?
  measurementFrequency String   // Monthly, Quarterly, Semester-wise, Annually
  responsiblePerson    String
  status               String   @default("On Track") // On Track, At Risk, Completed
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CmsPage {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @default(uuid())
  title          String
  slug           String    @unique
  pageType       String    // Home, About, Admission, Academic, Research, Department, Static, Landing, Custom
  content        String
  seoTitle       String?
  seoDescription String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model NewsArticle {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  title         String
  slug          String    @unique
  category      String
  featuredImage String?
  summary       String?
  content       String
  authorId      Int?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  featured      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Event {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @default(uuid())
  title                String
  description          String
  location             String
  startDate            DateTime
  endDate              DateTime
  organizer            String
  registrationRequired Boolean   @default(false)
  capacity             Int?
  bannerImage          String?
  published            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model MediaLibrary {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  fileName   String
  fileType   String
  fileUrl    String
  uploadedBy String
  folder     String   @default("General")
  tags       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AIConversation {
  id            Int          @id @default(autoincrement())
  uuid          String       @unique @default(uuid())
  userId        Int
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  assistantType String       // "University", "Student", "Faculty", "HR", "Finance", etc.
  messages      AIMessage[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
}

model AIMessage {
  id             Int            @id @default(autoincrement())
  uuid           String         @unique @default(uuid())
  conversationId Int
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // "User", "Assistant", "System"
  content        String
  tokenCount     Int?           @default(0)
  modelName      String?
  responseTime   Int?           @default(0) // milliseconds
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

model KnowledgeDocument {
  id              Int              @id @default(autoincrement())
  uuid            String           @unique @default(uuid())
  title           String
  category        String           // "Handbook", "Policy", "Regulation"
  source          String           // e.g. "Student Handbook"
  fileUrl         String?
  content         String?          // store full parsed text
  chunkCount      Int              @default(0)
  indexed         Boolean          @default(false)
  embeddingStatus String           @default("Pending") // "Pending", "Completed", "Failed"
  chunks          KnowledgeChunk[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model KnowledgeChunk {
  id         Int               @id @default(autoincrement())
  uuid       String            @unique @default(uuid())
  docId      Int
  document   KnowledgeDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  content    String
  embedding  String?           // Stored as JSON array string
  createdAt  DateTime          @default(now())

  @@index([docId])
}

model PromptTemplate {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  templateName String   @unique
  category     String   // "Academic", "HR", "Finance", etc.
  prompt       String
  variables    String   // comma-separated variables e.g. "studentName,courseName"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ApiClient {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  clientName   String
  clientId     String   @unique
  clientSecret String
  contactEmail String
  organization String
  status       String   // Active, Suspended, Revoked
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(uuid())
  keyName    String
  apiKey     String    @unique
  clientId   Int
  expiresAt  DateTime
  lastUsedAt DateTime?
  status     String    // Active, Revoked, Expired
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model WebhookEndpoint {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  name        String
  callbackUrl String
  secretKey   String
  eventType   String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IntegrationProvider {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  providerName String
  providerType String   // Payment, LMS, Government, Identity, Email, SMS, AI, Storage
  configuration String   // JSON configuration string
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Deployment {
  id          Int      @id @default(autoincrement())
  version     String
  environment String   // Development, Staging, Production
  deployedBy  String
  deployedAt  DateTime @default(now())
  status      String   // Running, Failed, RolledBack
}

model EnvironmentVariable {
  id             Int     @id @default(autoincrement())
  key            String
  valueEncrypted String
  environment    String  // Development, Staging, Production
  active         Boolean @default(true)
}

model Backup {
  id              Int       @id @default(autoincrement())
  backupType      String    // Database, Media, Configuration
  storageLocation String
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  status          String    // Pending, Completed, Failed
}

model InfrastructureAlert {
  id        Int      @id @default(autoincrement())
  severity  String   // Low, Medium, High, Critical
  source    String   // Server, Database, Queue, AI, Gateway
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DataWarehouseJob {
  id          Int       @id @default(autoincrement())
  jobName     String
  jobType     String    // ETL, ELT, Refresh, Cleanup
  status      String    // Pending, Running, Success, Failed
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model KPI {
  id           Int     @id @default(autoincrement())
  name         String
  category     String
  targetValue  Float
  currentValue Float
  trend        Float   // e.g. positive/negative offset, or percentage change
  active       Boolean @default(true)
}

model SavedReport {
  id            Int     @id @default(autoincrement())
  reportName    String
  reportType    String
  createdBy     String
  configuration String  // Serialized JSON
  schedule      String? // Optional report execution schedule
}

model Tenant {
  id                   Int                  @id @default(autoincrement())
  tenantCode           String               @unique
  tenantName           String
  universityName       String
  domain               String
  subdomain            String
  status               String               // Active, Suspended, Maintenance
  timezone             String
  locale               String
  currency             String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  configurations       TenantConfiguration[]
  maintenanceWindows   MaintenanceWindow[]
}

model TenantConfiguration {
  id                  Int      @id @default(autoincrement())
  tenantId            Int
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branding            String   // Serialized JSON
  logo                String
  favicon             String
  primaryColor        String
  secondaryColor      String
  emailConfiguration  String   // Serialized JSON
  smsConfiguration    String   // Serialized JSON
  aiConfiguration     String   // Serialized JSON
  storageConfiguration String   // Serialized JSON
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model RecoveryPoint {
  id              Int      @id @default(autoincrement())
  recoveryType    String   // Snapshot, Full Backup, Incremental Backup
  region          String
  storageProvider String
  storageLocation String
  checksum        String
  verified        Boolean
  createdAt       DateTime @default(now())
}

model MaintenanceWindow {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  active      Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Workflow {
  id           Int                 @id @default(autoincrement())
  uuid         String              @unique @default(uuid())
  workflowCode String              @unique
  workflowName String
  module       String
  version      String
  description  String?
  active       Boolean             @default(true)
  createdBy    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  steps        WorkflowStep[]
  executions   WorkflowExecution[]
}

model WorkflowStep {
  id            Int      @id @default(autoincrement())
  workflowId    Int
  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepName      String
  stepType      String   // Start, Approval, Task, Condition, Decision, Notification, Delay, Timer, API, Script, End
  configuration String   // JSON string
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workflowId])
}

model WorkflowExecution {
  id          Int                @id @default(autoincrement())
  workflowId  Int
  workflow    Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  entityId    String?
  status      String             @default("Pending") // Pending, Running, WaitingApproval, Approved, Rejected, Failed, Completed, Cancelled
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  approvals   WorkflowApproval[]

  @@index([workflowId])
}

model WorkflowApproval {
  id            Int               @id @default(autoincrement())
  executionId   Int
  execution     WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  approverId    Int // User id
  approvalLevel Int               @default(1)
  decision      String?           // Approved, Rejected, Pending
  comments      String?
  approvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([executionId])
}

model SearchIndex {
  id           Int      @id @default(autoincrement())
  module       String
  entityType   String
  entityId     String
  title        String
  content      String
  metadata     String?  // JSON string
  searchVector String?  // Optional text vector representation
  embeddingId  String?  // Optional vector embedding ID / string representation
  indexedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([module])
  @@index([entityType, entityId])
}

model SavedSearch {
  id         Int      @id @default(autoincrement())
  userId     Int
  searchName String
  query      String
  filters    String?  // JSON string
  createdAt  DateTime @default(now())

  @@index([userId])
}

model SearchHistory {
  id         Int      @id @default(autoincrement())
  userId     Int
  query      String
  module     String?
  searchType String   @default("text")
  executedAt DateTime @default(now())

  @@index([userId])
}

model SearchAnalytics {
  id            Int      @id @default(autoincrement())
  query         String
  resultCount   Int
  executionTime Int      // in ms
  clickedResult String?
  userId        Int?
  createdAt     DateTime @default(now())

  @@index([query])
}

model AuditEvent {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  module      String
  entityType  String
  entityId    String?
  action      String
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  performedBy String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model CompliancePolicy {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  policyCode    String   @unique
  policyName    String
  category      String
  description   String   @db.Text
  version       String
  status        String   // Draft, Active, Archived
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RiskRegister {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @default(uuid())
  riskCode       String   @unique
  title          String
  category       String
  probability    String   // Low, Medium, High
  impact         String   // Low, Medium, High
  severity       String   // Low, Medium, High, Critical
  owner          String
  mitigationPlan String   @db.Text
  status         String   // Open, Mitigated, Transferred, Avoided, Closed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditEvidence {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  auditId     String
  title       String
  description String   @db.Text
  fileUrl     String
  uploadedBy  String
  uploadedAt  DateTime @default(now())
}

model ApiApplication {
  id              Int               @id @default(autoincrement())
  applicationName String
  ownerId         Int
  description     String?           @db.Text
  apiKey          String            @unique
  status          String            @default("Active") // Active, Suspended, Revoked
  createdAt       DateTime          @default(now())
  webhooks        ApiWebhook[]
  subscriptions   ApiSubscription[]
  usages          ApiUsage[]
}

model ApiWebhook {
  id            Int            @id @default(autoincrement())
  applicationId Int
  application   ApiApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  webhookName   String
  url           String
  secret        String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  @@index([applicationId])
}

model ApiSubscription {
  id            Int            @id @default(autoincrement())
  applicationId Int
  application   ApiApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  apiName       String
  version       String
  plan          String
  subscribedAt  DateTime       @default(now())

  @@index([applicationId])
}

model ApiUsage {
  id            Int            @id @default(autoincrement())
  applicationId Int
  application   ApiApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  endpoint      String
  requestCount  Int            @default(0)
  errorCount    Int            @default(0)
  averageLatency Float          @default(0.0)
  recordedAt    DateTime       @default(now())

  @@index([applicationId])
}

model ManagedDevice {
  id              Int               @id @default(autoincrement())
  deviceName      String
  platform        String            // Android, iOS, Windows, macOS
  manufacturer    String
  model           String
  osVersion       String
  serialNumber    String            @unique
  imei            String?
  ownerId         Int?
  departmentId    Int?
  status          String            @default("Enrolled") // Enrolled, Pending, Blocked, Retired
  batteryLevel    Int               @default(100)
  lastSeen        DateTime          @default(now())
  createdAt       DateTime          @default(now())
  policyId        Int?
  policy          DevicePolicy?     @relation(fields: [policyId], references: [id])
  commands        DeviceCommand[]
  applications    DeviceApplication[]
}

model DevicePolicy {
  id                Int             @id @default(autoincrement())
  policyName        String
  description       String?         @db.Text
  passcodeRequired  Boolean         @default(false)
  encryptionRequired Boolean        @default(false)
  cameraAllowed     Boolean         @default(true)
  screenshotAllowed Boolean         @default(true)
  kioskMode         Boolean         @default(false)
  kioskApp          String?         // Single-app kiosk mode target app if active
  createdAt         DateTime        @default(now())
  devices           ManagedDevice[]
}

model DeviceCommand {
  id          Int           @id @default(autoincrement())
  deviceId    Int
  device      ManagedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  command     String        // Lock, Unlock, Restart, Wipe, Locate, Sync
  status      String        // Pending, Executed, Failed
  executedAt  DateTime?
  createdAt   DateTime      @default(now())
}

model DeviceApplication {
  id              Int           @id @default(autoincrement())
  deviceId        Int
  device          ManagedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  applicationName String
  version         String
  installed       Boolean       @default(true)
}








