  checkIn      DateTime  @default(now())
  checkOut     DateTime?
  approvedBy   String?
  remarks      String?   @db.VarChar(1000)
}

model HostelComplaint {
  id          Int        @id @default(autoincrement())
  studentId   Int
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  roomId      Int?
  room        HostelRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  title       String
  description String     @db.VarChar(2000)
  category    String     // Plumbing, Electrical, Cleaning, Furniture, Other
  status      String     @default("Pending") // Pending, In Progress, Resolved, Rejected
