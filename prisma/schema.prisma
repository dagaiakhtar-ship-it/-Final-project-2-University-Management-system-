datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ====================================================
// ENUMS (PART 6)
// ====================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
  RECRUITER
  PLACEMENT_OFFICER
  HOSTEL_WARDEN
  SECURITY_STAFF
  LIBRARIAN
  COMPLIANCE_OFFICER
  INTERNAL_AUDITOR
  RISK_MANAGER
  AUDITOR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ResultStatus {
  PASSED
  FAILED
  PENDING
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
  REFUNDED
}

enum NotificationType {
  SYSTEM
  ACADEMIC
  FEE
  ATTENDANCE
  ASSIGNMENT
  ANNOUNCEMENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SemesterStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  SUSPENDED
  ARCHIVED
}

enum SemesterType {
  REGULAR
  SUMMER
  WINTER
}

enum AcademicStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
  APPLIED
  WITHDRAWN
  ALUMNI
}

// ====================================================
// MODELS (PART 3, 4, 5, 7)
// ====================================================

model User {
  id                  Int       @id @default(autoincrement())
  uuid                String    @unique @default(uuid())
  email               String    @unique
  password            String
  username            String?   @unique
  firstName           String
  lastName            String
  avatarUrl           String?
  gender              Gender
  status              String    @default("ACTIVE")
  
  // Authentication foundation fields
  firebaseUid         String?   @unique
  isEmailVerified     Boolean   @default(false)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  accountLockedUntil  DateTime?
  passwordChangedAt   DateTime?
  lastLogin           DateTime?
  refreshTokenVersion Int       @default(0)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  createdBy           String?
  updatedBy           String?

  roleId              Int
  role                Role      @relation(fields: [roleId], references: [id])

  admin               Admin?
  teacher             Teacher?
  student             Student?
  parent              Parent?
  recruiter           Recruiter?
  wardenBuildings     HostelBuilding[] @relation("BuildingWarden")
  
  notifications       NotificationRecipient[]
  auditLogs           AuditLog[]
  bookReservations    BookReservation[]
  aiConversations     AIConversation[]

  @@index([roleId])
  @@index([email])
  @@index([username])
}

model Role {
  id          Int              @id @default(autoincrement())
  uuid        String           @unique @default(uuid())
  name        UserRole         @unique
  description String?
  status      String           @default("ACTIVE")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  uuid        String           @unique @default(uuid())
  name        String           @unique
  description String?
  status      String           @default("ACTIVE")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model University {
  id           Int           @id @default(autoincrement())
  uuid         String        @unique @default(uuid())
  name         String
  code         String        @unique
  address      String?
  contactEmail String?
  contactPhone String?
  status       String        @default("ACTIVE")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  departments   Department[]
  announcements Announcement[]
  systemSettings SystemSetting[]
}

model Department {
  id           Int        @id @default(autoincrement())
  uuid         String     @unique @default(uuid())
  name         String
  code         String     @unique
  shortName    String?
  description  String?
  faculty      String?
  officeLocation String?
  officePhone  String?
  officeEmail  String?
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  universityId Int
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  headOfDepartmentId Int?
  headOfDepartment   Teacher?   @relation("DepartmentHead", fields: [headOfDepartmentId], references: [id])

  programs     Program[]
  teachers     Teacher[]  @relation("DepartmentTeachers")
  students     Student[]  @relation("DepartmentStudents")
  rooms        Room[]
  sections     Section[]
  subjects     Subject[]
  courseOfferings CourseOffering[]
  leaveRequests LeaveRequest[]
  transcripts   Transcript[]
  degreeRequirements DegreeRequirement[]
  alumniProfiles AlumniProfile[]
  feeStructures FeeStructure[]
  researchProjects ResearchProject[]
  accreditationPrograms AccreditationProgram[]
  learningOutcomes LearningOutcome[]

  @@index([universityId])
  @@index([headOfDepartmentId])
}

model Program {
  id           Int        @id @default(autoincrement())
  uuid         String     @unique @default(uuid())
  name         String
  code         String     @unique
  shortName    String?
  degreeLevel  String     // Diploma, Associate, BS, MS, MPhil, PhD
  duration     Int        // Duration in semesters or years
  totalSemesters Int
  creditHours  Int
  description  String?    @db.VarChar(500)
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  coordinatorId Int?
  coordinator   Teacher?  @relation("ProgramCoordinator", fields: [coordinatorId], references: [id])

  semesters    Semester[]
  students     Student[]
  sections     Section[]
  subjects     Subject[]
  courseOfferings CourseOffering[]
  transcripts  Transcript[]
  degreeRequirements DegreeRequirement[]
  alumniProfiles AlumniProfile[]
  feeStructures FeeStructure[]
  accreditationPrograms AccreditationProgram[]
  learningOutcomes LearningOutcome[]

  @@index([departmentId])
  @@index([coordinatorId])
}

model Semester {
  id                    Int            @id @default(autoincrement())
  uuid                  String         @unique @default(uuid())
  name                  String
  code                  String
  semesterNumber        Int
  semesterType          SemesterType   @default(REGULAR)
  status                SemesterStatus @default(UPCOMING)
  startDate             DateTime
  endDate               DateTime
  registrationStartDate DateTime
  registrationEndDate   DateTime
  minCreditHours        Int            @default(1)
  maxCreditHours        Int            @default(18)
  description           String?        @db.VarChar(500)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?
  createdBy             String?
  updatedBy             String?

  programId             Int
  program               Program        @relation(fields: [programId], references: [id], onDelete: Cascade)

  academicYearId        Int
  academicYear          AcademicYear   @relation(fields: [academicYearId], references: [id])

  subjects              Subject[]
  sections              Section[]
  courseOfferings       CourseOffering[]
  students              Student[]        @relation("SemesterStudents")
  results               Result[]
  semesterGPAs          SemesterGPA[]
  feeStructures         FeeStructure[]
  invoices              StudentInvoice[]

  @@index([programId])
  @@index([academicYearId])
}

model Section {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(uuid())
  code            String    // Section Code (Unique within Semester)
  name            String
  status          String    @default("ACTIVE") // ACTIVE, INACTIVE
  capacity        Int       @default(60)
  currentStrength Int       @default(0)
  shift           String    @default("MORNING") // MORNING, EVENING
  description     String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  semesterId      Int
  semester        Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  programId       Int?
  program         Program?  @relation(fields: [programId], references: [id])

  departmentId    Int?
  department      Department? @relation(fields: [departmentId], references: [id])

  academicYearId  Int?
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])

  classAdvisorId  Int?
  classAdvisor    Teacher?  @relation("SectionAdvisor", fields: [classAdvisorId], references: [id])

  students           Student[]
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]
  courseOfferings    CourseOffering[]

  @@unique([semesterId, code])
  @@index([semesterId])
  @@index([programId])
  @@index([departmentId])
  @@index([academicYearId])
  @@index([classAdvisorId])
}

model Course {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  name        String
  code        String    @unique
  description String?
  credits     Int
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  subjects    Subject[]
}

model Subject {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(uuid())
  code           String       @unique
  name           String
  shortName      String?
  creditHours    Int          @default(3)
  theoryHours    Int          @default(3)
  labHours       Int          @default(0)
  subjectType    String       @default("Theory") // Theory, Lab, Mixed
  category       String       @default("Core")   // Core, Elective, General
  description    String?      @db.VarChar(500)
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  departmentId   Int
  department     Department   @relation(fields: [departmentId], references: [id])

  programId      Int
  program        Program      @relation(fields: [programId], references: [id])

  semesterId     Int
  semester       Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  prerequisiteId Int?
  prerequisite   Subject?     @relation("SubjectPrerequisite", fields: [prerequisiteId], references: [id])
  prerequisites  Subject[]    @relation("SubjectPrerequisite")

  courseId       Int?
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  teacherId      Int?
  teacher        Teacher?     @relation(fields: [teacherId], references: [id])

  timetables     Timetable[]
  exams          Exam[]
  courseOfferings CourseOffering[]

  @@index([courseId])
  @@index([semesterId])
  @@index([teacherId])
  @@index([departmentId])
  @@index([programId])
  @@index([prerequisiteId])
}

model AcademicYear {
  id          Int            @id @default(autoincrement())
  uuid        String         @unique @default(uuid())
  name        String         @unique
  startDate   DateTime
  endDate     DateTime
  status      AcademicStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  semesters   Semester[]
  students    Student[]
  fees        Fee[]
  sections    Section[]
}

model Student {
  id                   Int            @id @default(autoincrement())
  uuid                 String         @unique @default(uuid())
  registrationNumber   String         @unique
  rollNumber           String         @unique
  idCardNumber         String?        @unique
  status               AcademicStatus @default(ACTIVE)
  enrollmentStatus     String?        @default("Pending") // Pending, Enrolled, Deferred
  
  // Personal Info
  fullName             String?
  fatherName           String?
  motherName           String?
  guardianRelationship String?
  dateOfBirth          DateTime?
  gender               String?
  bloodGroup           String?
  nationality          String?
  cnic                 String?
  
  // Contact Info
  email                String?
  mobileNumber         String?
  emergencyContact     String?
  permanentAddress     String?
  currentAddress       String?
  city                 String?
  province             String?
  country              String?
  postalCode           String?
  
  // Academic History
  previousInstitution  String?
  previousQualification String?
  previousCgpa         Float?
  admissionMeritNumber Int?
  admissionSession     String?
  admissionDate        DateTime?
  
  // Preferences/Facilities
  scholarshipStatus    String?
  hostelStatus         String?
  transportStatus      String?
  medicalNotes         String?
  
  // Media
  studentPhoto         String?
  signatureImage       String?

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?
  createdBy            String?
  updatedBy            String?

  userId               Int            @unique
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId         Int
  department           Department     @relation("DepartmentStudents", fields: [departmentId], references: [id])

  programId            Int
  program              Program        @relation(fields: [programId], references: [id])

  semesterId           Int
  semester             Semester       @relation("SemesterStudents", fields: [semesterId], references: [id])

  sectionId            Int?
  section              Section?       @relation(fields: [sectionId], references: [id])

  academicYearId       Int
  academicYear         AcademicYear   @relation(fields: [academicYearId], references: [id])

  parentId             Int?
  parent               Parent?        @relation(fields: [parentId], references: [id])

  attendanceRecords     AttendanceRecord[]
  assignmentSubmissions AssignmentSubmission[]
  quizSubmissions       QuizSubmission[]
  results               Result[]
  semesterGPAs          SemesterGPA[]
  cgpaRecords           CGPARecord[]
  feePayments          FeePayment[]
  leaveRequests        LeaveRequest[]
  enrollments          Enrollment[]
  examSeatPlans        ExamSeatPlan[]
  transcripts          Transcript[]
  transcriptRequests   TranscriptRequest[]
  degreeAudits         DegreeAudit[]
  graduationApplications GraduationApplication[]
  alumniProfile        AlumniProfile?
  mentorshipsAsMentee  AlumniMentorship[]      @relation("MenteeRelation")
  alumniEventParticipations AlumniEventParticipant[]
  jobApplications      JobApplication[]
  hostelAllocations    HostelAllocation[]
  visitorLogs          VisitorLog[]
  hostelComplaints     HostelComplaint[]
  transportRegistrations TransportRegistration[]
  bookIssues           BookIssue[]
  invoices             StudentInvoice[]
  scholarships         Scholarship[]

  @@index([userId])
  @@index([departmentId])
  @@index([programId])
  @@index([semesterId])
  @@index([sectionId])
  @@index([academicYearId])
  @@index([parentId])
}

model Teacher {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(uuid())
  employeeId   String    @unique
  designation  String?
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  // Faculty profile fields (Step 25 HR & Academic Management)
  employmentType   String?   @default("Permanent") // Permanent, Contract, Visiting
  qualification    String?
  specialization   String?
  experience       Int?      // In years
  joiningDate      DateTime?
  officeLocation   String?
  officePhone      String?
  profilePhoto     String?
  cnic             String?   // Encrypted if stored (can store as string or hashed/encrypted)
  emergencyContact String?
  biography        String?   @db.VarChar(1000)

  userId       Int       @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId Int
  department   Department @relation("DepartmentTeachers", fields: [departmentId], references: [id])

  headedDepartments  Department[] @relation("DepartmentHead")
  coordinatedPrograms Program[]  @relation("ProgramCoordinator")

  subjects           Subject[]
  attendanceSessions AttendanceSession[]
  leaveRequests      LeaveRequest[]
  advisedSections    Section[] @relation("SectionAdvisor")
  courseOfferings    CourseOffering[]
  timetables         Timetable[]
  assignments        Assignment[]
  quizzes            Quiz[]
  questionBanks      QuestionBank[]
  exams              Exam[]
  invigilations      ExamInvigilator[]
  transportRegistrations TransportRegistration[]
  bookIssues           BookIssue[]
  researchProjects     ResearchProject[]

  @@index([userId])
  @@index([departmentId])
}

model Parent {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(uuid())
  occupation String?
  relation   String
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  createdBy  String?
  updatedBy  String?

  userId     Int       @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  students   Student[]

  @@index([userId])
}

model Admin {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(uuid())
  department String?
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  createdBy  String?
  updatedBy  String?

  userId     Int       @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AttendanceSession {
  id                 Int                @id @default(autoincrement())
  uuid               String             @unique @default(uuid())
  
  timetableId        Int?
  timetable          Timetable?         @relation(fields: [timetableId], references: [id], onDelete: SetNull)
  
  courseOfferingId   Int
  courseOffering     CourseOffering     @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  
  teacherId          Int
  teacher            Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  
  sectionId          Int
  section            Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  
  roomId             Int
  room               Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  attendanceDate     DateTime
  startTime          String
  endTime            String
  sessionStatus      String             @default("Scheduled") // Scheduled, Started, Completed, Cancelled, Locked
  attendanceMethod   String             @default("Manual") // Manual, QR Code, Biometric, Hybrid
  
  qrCodeToken        String?            @unique
  qrCodeExpiry       DateTime?
  notes              String?            @db.VarChar(500)
  
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  attendanceRecords  AttendanceRecord[]

  @@index([timetableId])
  @@index([courseOfferingId])
  @@index([teacherId])
  @@index([sectionId])
  @@index([roomId])
}

model AttendanceRecord {
  id                  Int               @id @default(autoincrement())
  uuid                String            @unique @default(uuid())
  
  attendanceSessionId Int
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  
  studentId           Int
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  enrollmentId        Int
  enrollment          Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  
  attendanceStatus    String            @default("Present") // Present, Absent, Late, Excused, Medical Leave, Official Leave, Holiday
  arrivalTime         String?
  remarks             String?           @db.VarChar(500)
  markedBy            String?
  editedBy            String?
  editReason          String?           @db.VarChar(500)
  
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  @@unique([attendanceSessionId, studentId])
  @@index([attendanceSessionId])
  @@index([studentId])
  @@index([enrollmentId])
}

model Result {
  id                 Int            @id @default(autoincrement())
  resultCode         String         @unique @default(uuid())
  studentId          Int
  student            Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollmentId       Int
  enrollment         Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  courseOfferingId   Int
  courseOffering     CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  semesterId         Int
  semester           Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  academicYear       String
  session            String
  assignmentMarks    Float?
  quizMarks          Float?
  midtermMarks       Float?
  finalExamMarks     Float?
  practicalMarks     Float?
  vivaMarks          Float?
  makeupMarks        Float?
  totalObtainedMarks Float
  totalMarks         Float
  percentage         Float
  grade              String
  gradePoint         Float
  creditHours        Float
  qualityPoints      Float
  passStatus         String         @default("Pass") // Pass, Fail, Incomplete, Withheld
  remarks            String?        @db.VarChar(500)
  approvalStatus     String         @default("Draft") // Draft, Submitted, Approved, Published
  approvedBy         String?
  approvedAt         DateTime?
  publishedAt        DateTime?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  softDelete         Boolean        @default(false)

  @@unique([studentId, courseOfferingId])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([courseOfferingId])
  @@index([semesterId])
}

model SemesterGPA {
  id                 Int      @id @default(autoincrement())
  studentId          Int
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semesterId         Int
  semester           Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  totalCreditHours   Float
  earnedCreditHours  Float
  totalQualityPoints Float
  semesterGPA        Float
  classRank          Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([studentId, semesterId])
  @@index([studentId])
  @@index([semesterId])
}

model CGPARecord {
  id                      Int      @id @default(autoincrement())
  studentId               Int      @unique
  student                 Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalCreditHours        Float
  earnedCreditHours       Float
  cumulativeQualityPoints Float
  cgpa                    Float
  graduationStatus        String   @default("In Progress")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([studentId])
}

model Assignment {
  id                    Int                    @id @default(autoincrement())
  uuid                  String                 @unique @default(uuid())
  assignmentCode        String                 @unique // Auto-generated, Unique
  title                 String
  description           String?                @db.VarChar(1000)
  instructions          String?                @db.VarChar(5000)
  
  courseOfferingId      Int
  courseOffering        CourseOffering         @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  
  teacherId             Int
  teacher               Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  
  totalMarks            Float
  passingMarks          Float
  assignmentType        String                 // Homework, Project, Lab, Presentation, Research, Viva Preparation
  
  publishDate           DateTime               @default(now())
  dueDate               DateTime
  allowLateSubmission   Boolean                @default(false)
  latePenaltyPercentage Float                  @default(0)
  maxAttempts           Int                    @default(1)
  attachments           String?                @db.VarChar(2000)
  visibilityStatus      String                 @default("Draft") // Draft, Published, Archived
  
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  softDelete            Boolean                @default(false)

  submissions           AssignmentSubmission[]

  @@index([courseOfferingId])
  @@index([teacherId])
}

model AssignmentSubmission {
  id               Int            @id @default(autoincrement())
  uuid             String         @unique @default(uuid())
  
  assignmentId     Int
  assignment       Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  studentId        Int
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  enrollmentId     Int
  enrollment       Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  
  submissionNumber Int            @default(1)
  submittedAt      DateTime       @default(now())
  submissionStatus String         @default("Draft") // Draft, Submitted, Late, Returned, Graded
  
  obtainedMarks    Float?
  percentage       Float?
  grade            String?
  feedback         String?        @db.VarChar(2000)
  teacherRemarks   String?        @db.VarChar(2000)
