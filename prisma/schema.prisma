  id            Int                     @id @default(autoincrement())
  routeId       Int
  route         TransportRoute          @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopName      String
  latitude      Float
  longitude     Float
  arrivalTime   String
  departureTime String
  sequence      Int
  pickups       TransportRegistration[] @relation("PickupStop")
  drops         TransportRegistration[] @relation("DropStop")

  @@index([routeId])
}

model TransportRegistration {
  id              Int             @id @default(autoincrement())
  studentId       Int?
  student         Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  employeeId      Int?
  employee        Teacher?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  routeId         Int
  route           TransportRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pickupStopId    Int
  pickupStop      TransportStop   @relation("PickupStop", fields: [pickupStopId], references: [id], onDelete: Cascade)
  dropStopId      Int
  dropStop        TransportStop   @relation("DropStop", fields: [dropStopId], references: [id], onDelete: Cascade)
  qrCode          String          @db.VarChar(2000)
  passNumber      String          @unique
  validFrom       DateTime
  validUntil      DateTime
  transportStatus String          @default("Pending") // Active, Pending, Suspended, Expired
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  attendances     TransportAttendance[]

  @@index([studentId])
  @@index([employeeId])
  @@index([routeId])
  @@index([pickupStopId])
  @@index([dropStopId])
}

model VehicleMaintenance {
  id              Int      @id @default(autoincrement())
