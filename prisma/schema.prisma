  description String     @db.VarChar(2000)
  category    String     // Plumbing, Electrical, Infrastructure, Furniture, Other
  priority    String     // Low, Medium, High, Urgent
  status      String     @default("Pending") // Pending, Scheduled, In Progress, Completed, Cancelled
  cost        Float      @default(0.0)
  remarks     String?    @db.VarChar(1000)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Vehicle {
  id                 Int                  @id @default(autoincrement())
  vehicleNumber      String               @unique
  registrationNumber String
  vehicleType        String               // Bus, Van, Mini Bus
  manufacturer       String
  model              String
  year               Int
  seatingCapacity    Int
  fuelType           String
  insuranceExpiry    DateTime
  fitnessExpiry      DateTime
  status             String               @default("Active") // Active, Maintenance, Out of Service
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  drivers            Driver[]
  maintenances       VehicleMaintenance[]
  fuelLogs           VehicleFuelLog[]
  trips              VehicleTrip[]
}

model Driver {
  id                 Int                  @id @default(autoincrement())
  fullName           String
  phone              String
  email              String               @unique
  licenseNumber      String               @unique
  licenseExpiry      DateTime
  address            String
  emergencyContact   String
  assignedVehicleId  Int?
  assignedVehicle    Vehicle?             @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  status             String               @default("Active") // Active, Leave, Suspended
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  attendances        TransportAttendance[]
  trips              VehicleTrip[]

  @@index([assignedVehicleId])
}

model TransportRoute {
  id                Int                     @id @default(autoincrement())
  routeName         String
  routeCode         String                  @unique
  startLocation     String
  endLocation       String
  estimatedDistance Float
  estimatedTime     String
  fare              Float                   @default(0.0)
  active            Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  stops             TransportStop[]
  registrations     TransportRegistration[]
  trips              VehicleTrip[]
}

