  title            String
  examType         String            // Midterm, Final, Practical, Viva, Makeup, Retake
  courseOfferingId Int
  courseOffering   CourseOffering    @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  subjectId        Int
  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId        Int
  teacher          Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  totalMarks       Float
  passingMarks     Float
  durationMinutes  Int
  examDate         DateTime
  startTime        String            // HH:MM
  endTime          String            // HH:MM
  roomId           Int?
  room             Room?             @relation(fields: [roomId], references: [id])
  buildingId       Int?
  building         Building?         @relation(fields: [buildingId], references: [id])
  session          String
  academicYear     String
  instructions     String?           @db.VarChar(5000)
  status           String            @default("Draft") // Draft, Scheduled, Ongoing, Completed, Cancelled
