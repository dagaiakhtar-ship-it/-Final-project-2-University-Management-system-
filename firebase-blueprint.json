{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a system user with login credentials and base profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier (UUID or Firebase UID)" },
        "email": { "type": "string", "format": "email" },
        "username": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "avatarUrl": { "type": "string", "format": "uri" },
        "gender": { "type": "string", "enum": ["MALE", "FEMALE", "OTHER"] },
        "roleId": { "type": "string", "description": "Reference to the associated Role ID" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "SUSPENDED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "email", "firstName", "lastName", "roleId", "gender", "status", "createdAt", "updatedAt"]
    },
    "Role": {
      "title": "Role",
      "description": "Defines access control groups and system responsibilities",
